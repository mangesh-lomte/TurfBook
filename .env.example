# TurfBook Platform Environment Variables Template

# Backend API Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turfbook?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turfbook_test?schema=public"

# Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="replace-with-secure-32-char-random-jwt-access-secret"
JWT_REFRESH_SECRET="replace-with-secure-32-char-random-jwt-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Frontend Configuration
VITE_API_URL="http://localhost:5000/api/v1"
