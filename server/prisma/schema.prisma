datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum VenueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  SIMULATED
  STRIPE
  RAZORPAY
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  VENUE_APPROVED
  VENUE_REJECTED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SYSTEM
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  fullName        String           @map("full_name")
  phone           String?
  role            Role             @default(CUSTOMER)
  isActive        Boolean          @default(true) @map("is_active")
  avatarUrl       String?          @map("avatar_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  venues          Venue[]          @relation("OwnerVenues")
  bookings        Booking[]        @relation("CustomerBookings")
  reviews         Review[]
  notifications   Notification[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  blockedPeriods  BlockedPeriod[]  @relation("BlockedBy")

  @@map("users")
}

model Venue {
  id             String           @id @default(uuid()) @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid
  name           String
  slug           String           @unique
  description    String           @db.Text
  address        String
  city           String
  state          String
  postalCode     String           @map("postal_code")
  latitude       Float?
  longitude      Float?
  contactPhone   String           @map("contact_phone")
  contactEmail   String           @map("contact_email")
  facilities     String[]         @default([])
  images         String[]         @default([])
  status         VenueStatus      @default(PENDING)
  isFeatured     Boolean          @default(false) @map("is_featured")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  owner          User             @relation("OwnerVenues", fields: [ownerId], references: [id], onDelete: Cascade)
  grounds        Ground[]
  operatingHours OperatingHours[]
  venueSports    VenueSport[]
  reviews        Review[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@map("venues")
}

model Sport {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  slug        String       @unique
  icon        String?
  description String?
  minPlayers  Int          @default(2) @map("min_players")
  maxPlayers  Int          @default(22) @map("max_players")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  grounds     Ground[]
  venueSports VenueSport[]

  @@map("sports")
}

model VenueSport {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  sportId   String   @map("sport_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([venueId, sportId])
  @@index([venueId])
  @@index([sportId])
  @@map("venue_sports")
}

model Ground {
  id                     String          @id @default(uuid()) @db.Uuid
  venueId                String          @map("venue_id") @db.Uuid
  sportId                String          @map("sport_id") @db.Uuid
  name                   String
  description            String?         @db.Text
  surfaceType            String          @map("surface_type")
  isIndoor               Boolean         @default(false) @map("is_indoor")
  hourlyRate             Decimal         @map("hourly_rate") @db.Decimal(10, 2)
  minSlotDurationMinutes Int             @default(60) @map("min_slot_duration_minutes")
  maxSlotDurationMinutes Int             @default(180) @map("max_slot_duration_minutes")
  isActive               Boolean         @default(true) @map("is_active")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  venue                  Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport                  Sport           @relation(fields: [sportId], references: [id], onDelete: Restrict)
  bookings               Booking[]
  blockedPeriods         BlockedPeriod[]

  @@index([venueId])
  @@index([sportId])
  @@map("grounds")
}

model OperatingHours {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String   @map("open_time") // "06:00" format HH:MM
  closeTime String   @map("close_time") // "23:00" format HH:MM
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@index([venueId])
  @@map("operating_hours")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingNumber      String        @unique @map("booking_number")
  customerId         String        @map("customer_id") @db.Uuid
  groundId           String        @map("ground_id") @db.Uuid
  startTime          DateTime      @map("start_time")
  endTime            DateTime      @map("end_time")
  totalHours         Decimal       @map("total_hours") @db.Decimal(4, 2)
  hourlyRate         Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  subtotal           Decimal       @db.Decimal(10, 2)
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  tax                Decimal       @default(0) @db.Decimal(10, 2)
  totalPrice         Decimal       @map("total_price") @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING_PAYMENT)
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at")
  notes              String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer           User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  ground             Ground        @relation(fields: [groundId], references: [id], onDelete: Restrict)
  payments           Payment[]
  review             Review?

  @@index([customerId])
  @@index([groundId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model BlockedPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  groundId    String   @map("ground_id") @db.Uuid
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  ground      Ground   @relation(fields: [groundId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("BlockedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groundId])
  @@index([startTime, endTime])
  @@map("blocked_periods")
}

model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  paymentNumber  String          @unique @map("payment_number")
  bookingId      String          @map("booking_id") @db.Uuid
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider @default(SIMULATED)
  transactionRef String?         @map("transaction_ref")
  failureReason  String?         @map("failure_reason")
  refundedAt     DateTime?       @map("refunded_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Review {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @unique @map("booking_id") @db.Uuid
  venueId        String   @map("venue_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  rating         Int
  comment        String   @db.Text
  isVerifiedStay Boolean  @default(true) @map("is_verified_stay")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([venueId])
  @@index([customerId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("userId") @db.Uuid
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model RefreshSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@map("audit_logs")
}
